# Скопируй этот файл в .env и заполни своими значениями.
# .env НЕ попадает в git (см. .gitignore) — токен останется только у тебя.

# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую (свой ID можно узнать у @userinfobot)
ADMIN_IDS=123456789

# Путь к файлу базы данных (необязательно, по умолчанию bot_database.db)
DB_PATH=bot_database.db

# Ссылка на бонус, который получает пользователь после одобрения заявки
BONUS_LINK=https://example.com/bonus
